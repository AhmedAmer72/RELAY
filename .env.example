# Public frontend configuration. Never put private keys in NEXT_PUBLIC_ variables.
# Verified 2026-10-25 against https://mezo.org/docs/users/resources/contracts-reference/
# and https://mezo.org/docs/developers/getting-started/configure-environment/
# plus on-chain reads of symbol, name, and decimals.

# testnet (default) or local (Hardhat only). Mainnet transactions are not enabled.
NEXT_PUBLIC_CHAIN_ENV=testnet

# Mezo Testnet
NEXT_PUBLIC_MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_MUSD_TESTNET_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
NEXT_PUBLIC_ESCROW_TESTNET_ADDRESS=0x22535C947Fd951bbC6C03f8D8A1159ad3a159c46
NEXT_PUBLIC_ESCROW_LEGACY_ADDRESS=0xcf6a53b0A22989Ad6B1834C7844CfB9B0d3A9125
NEXT_PUBLIC_EXPLORER_BASE_URL=https://explorer.test.mezo.org
# Earliest escrow block. Indexing uses the older of this value and the legacy deployment.
# Current contract, with agent budgets and split settlement, was deployed at block 16369215.
NEXT_PUBLIC_ESCROW_DEPLOY_BLOCK=16358867

# Local Hardhat only. Used when NEXT_PUBLIC_CHAIN_ENV=local.
# NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_LOCAL_MUSD_ADDRESS=
# NEXT_PUBLIC_LOCAL_ESCROW_ADDRESS=

# Server-side deployment only. Never commit a real value.
# MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
# MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# DEPLOYER_PRIVATE_KEY=
