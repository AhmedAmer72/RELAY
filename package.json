{
  "name": "relay",
  "version": "1.0.0",
  "private": true,
  "description": "RELAY — non-custodial protected MUSD checkout on Mezo. Secure the deal. Move the value.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile": "hardhat compile && node scripts/export-abi.mjs",
    "test:contracts": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "test:e2e": "node e2e/local-flow.mjs",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network mezoTestnet",
    "read:musd": "node scripts/read-musd.mjs",
    "check": "npm run compile && npm run test:contracts && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "motion": "^14.6.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.11",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "hardhat": "^2.29.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
